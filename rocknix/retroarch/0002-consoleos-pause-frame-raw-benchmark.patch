diff --git a/command.c b/command.c
index 9133736..83a95c0 100644
--- a/command.c
+++ b/command.c
@@ -22,0 +23,5 @@
+#if defined(__linux__)
+#include <errno.h>
+#include <unistd.h>
+#include <features/features_cpu.h>
+#endif
@@ -70,0 +76,3 @@
+#ifdef HAVE_SCREENSHOTS
+#include "tasks/tasks_internal.h"
+#endif
@@ -914,0 +923,390 @@ bool command_get_load_state_status(command_t *cmd, const char *arg)
+#if defined(__linux__)
+#define PAUSE_FRAME_NEXT "/run/consoleos/pause-frame.next"
+#define PAUSE_FRAME_RAW  "/run/consoleos/pause-frame.raw"
+#define PAUSE_FRAME_FORMAT_RGBA8888 1U
+#define PAUSE_FRAME_FORMAT_RGB565 2U
+#define PAUSE_FRAME_ORIENTATION_TOP_LEFT 1U
+
+struct pause_frame_header
+{
+   uint8_t magic[8];
+   uint32_t version;
+   uint32_t header_bytes;
+   uint64_t generation;
+   uint32_t width;
+   uint32_t height;
+   uint32_t stride;
+   uint32_t format;
+   uint32_t orientation;
+   uint32_t reserved;
+   uint64_t payload_bytes;
+};
+
+struct pause_frame_capture
+{
+   uint8_t *pixels;
+   unsigned width;
+   unsigned height;
+   unsigned bytes_per_pixel;
+   unsigned format;
+   const char *format_name;
+   const char *failure;
+   retro_time_t conversion_us;
+};
+
+static void pause_frame_reply(command_t *cmd, bool ready,
+      uint64_t generation, const char *detail,
+      unsigned width, unsigned height, unsigned bytes_per_pixel,
+      const char *format_name)
+{
+   char reply[160];
+   size_t len = ready
+         ? snprintf(reply, sizeof(reply),
+               "PAUSE_FRAME_READY %" PRIu64 " %u %u %u %s\n",
+               generation, width, height, width * bytes_per_pixel,
+               format_name)
+         : snprintf(reply, sizeof(reply),
+               "PAUSE_FRAME_FAILED %" PRIu64 " %s\n",
+               generation, detail ? detail : "unknown");
+   cmd->replier(cmd, reply, len);
+}
+
+static bool pause_frame_parse(const char *arg,
+      uint64_t *generation, unsigned *scale)
+{
+   char *end;
+   unsigned long long parsed_generation;
+   unsigned long parsed_scale;
+
+   *generation = 0;
+   *scale      = 0;
+   if (!arg || *arg < '1' || *arg > '9')
+      return false;
+   errno = 0;
+   parsed_generation = strtoull(arg, &end, 10);
+   if (errno || !parsed_generation || *end != ' ')
+      return false;
+   *generation = (uint64_t)parsed_generation;
+   while (*end == ' ')
+      end++;
+   if (*end < '1' || *end > '2')
+      return false;
+   errno = 0;
+   parsed_scale = strtoul(end, &end, 10);
+   if (errno || *end || (parsed_scale != 1 && parsed_scale != 2))
+      return false;
+   *scale = (unsigned)parsed_scale;
+   return true;
+}
+
+static bool pause_frame_dimensions(unsigned width, unsigned height,
+      unsigned bytes_per_pixel)
+{
+   return width && height && bytes_per_pixel
+         && width <= SIZE_MAX / bytes_per_pixel
+         && height <= SIZE_MAX / ((size_t)width * bytes_per_pixel);
+}
+
+static void pause_frame_read(void *userdata, const void *data,
+      unsigned width, unsigned height, size_t pitch)
+{
+   struct pause_frame_capture *capture =
+      (struct pause_frame_capture*)userdata;
+   unsigned y;
+   unsigned bytes_per_pixel = capture->bytes_per_pixel;
+   retro_time_t conversion_started = 0;
+
+   if (!data || !pause_frame_dimensions(width, height, bytes_per_pixel)
+         || pitch < (size_t)width * bytes_per_pixel)
+      return;
+   capture->pixels = (uint8_t*)malloc(
+         (size_t)width * height * bytes_per_pixel);
+   if (!capture->pixels)
+   {
+      capture->failure = "allocation_failed";
+      return;
+   }
+   for (y = 0; y < height; y++)
+   {
+      const uint8_t *src = (const uint8_t*)data + (size_t)y * pitch;
+      uint8_t *dst = capture->pixels
+            + (size_t)y * width * bytes_per_pixel;
+      unsigned x;
+      if (capture->format == PAUSE_FRAME_FORMAT_RGB565)
+      {
+         memcpy(dst, src, (size_t)width * bytes_per_pixel);
+         continue;
+      }
+      if (!conversion_started)
+         conversion_started = cpu_features_get_time_usec();
+      for (x = 0; x < width; x++, dst += 4)
+      {
+         uint32_t pixel;
+         memcpy(&pixel, src + (size_t)x * 4U, sizeof(pixel));
+         dst[0] = (uint8_t)(pixel >> 16);
+         dst[1] = (uint8_t)(pixel >> 8);
+         dst[2] = (uint8_t)pixel;
+         dst[3] = 0xffU;
+      }
+   }
+   capture->width   = width;
+   capture->height  = height;
+   capture->failure = NULL;
+   if (conversion_started)
+      capture->conversion_us =
+            cpu_features_get_time_usec() - conversion_started;
+}
+
+#if defined(HAVE_SCREENSHOTS)
+static bool pause_frame_read_gpu(struct pause_frame_capture *capture,
+      uint32_t runloop_flags, retro_time_t *readback_us)
+{
+   video_driver_state_t *video_st = video_state_get_ptr();
+   uint8_t *bgr = NULL;
+   unsigned width = 0;
+   unsigned height = 0;
+   size_t pitch = 0;
+   unsigned y;
+   retro_time_t started = cpu_features_get_time_usec();
+   retro_time_t pixels_ready;
+
+   /* Match the normal SCREENSHOT viewport preparation exactly. */
+   if (video_st->poke && video_st->poke->set_texture_enable)
+      video_st->poke->set_texture_enable(video_st->data, false, false);
+   if (!(runloop_flags & RUNLOOP_FLAG_IDLE))
+      video_driver_cached_frame();
+   if (!screenshot_read_viewport(&bgr, &width, &height, &pitch,
+            runloop_flags & RUNLOOP_FLAG_IDLE))
+      return false;
+   pixels_ready = cpu_features_get_time_usec();
+   *readback_us = pixels_ready - started;
+
+   if (!pause_frame_dimensions(width, height, 4U))
+   {
+      free(bgr);
+      return false;
+   }
+   capture->pixels = (uint8_t*)malloc((size_t)width * height * 4U);
+   if (!capture->pixels)
+   {
+      free(bgr);
+      capture->failure = "allocation_failed";
+      return false;
+   }
+   for (y = 0; y < height; y++)
+   {
+      const uint8_t *src = bgr + (size_t)(height - 1U - y) * pitch;
+      uint8_t *dst = capture->pixels + (size_t)y * width * 4U;
+      unsigned x;
+      for (x = 0; x < width; x++, src += 3, dst += 4)
+      {
+         dst[0] = src[2];
+         dst[1] = src[1];
+         dst[2] = src[0];
+         dst[3] = 0xffU;
+      }
+   }
+   free(bgr);
+   capture->width          = width;
+   capture->height         = height;
+   capture->bytes_per_pixel = 4U;
+   capture->format         = PAUSE_FRAME_FORMAT_RGBA8888;
+   capture->format_name    = "RGBA8888";
+   capture->failure        = NULL;
+   capture->conversion_us  = cpu_features_get_time_usec() - pixels_ready;
+   return true;
+}
+#endif
+
+static uint8_t *pause_frame_half(const uint8_t *source,
+      unsigned width, unsigned height, unsigned bytes_per_pixel)
+{
+   unsigned out_width  = width / 2U;
+   unsigned out_height = height / 2U;
+   uint8_t *output;
+   unsigned y;
+
+   if (!out_width || !out_height)
+      return NULL;
+   output = (uint8_t*)malloc(
+         (size_t)out_width * out_height * bytes_per_pixel);
+   if (!output)
+      return NULL;
+   for (y = 0; y < out_height; y++)
+   {
+      const uint8_t *src = source
+            + (size_t)(y * 2U) * width * bytes_per_pixel;
+      uint8_t *dst = output + (size_t)y * out_width * bytes_per_pixel;
+      unsigned x;
+      for (x = 0; x < out_width; x++)
+         memcpy(dst + (size_t)x * bytes_per_pixel,
+               src + (size_t)(x * 2U) * bytes_per_pixel,
+               bytes_per_pixel);
+   }
+   return output;
+}
+
+static bool pause_frame_publish(uint64_t generation,
+      const uint8_t *pixels, unsigned width, unsigned height,
+      unsigned bytes_per_pixel, unsigned format, const char **failure)
+{
+   struct pause_frame_header header = {
+      {'C','O','S','P','F','R','A','W'}, 1U,
+      sizeof(struct pause_frame_header), generation,
+      width, height, width * bytes_per_pixel, format,
+      PAUSE_FRAME_ORIENTATION_TOP_LEFT, 0U,
+      (uint64_t)width * height * bytes_per_pixel
+   };
+   FILE *file;
+   bool okay;
+
+   _Static_assert(sizeof(struct pause_frame_header) == 56U,
+         "pause frame header layout changed");
+   if (!(file = fopen(PAUSE_FRAME_NEXT, "wb")))
+   {
+      *failure = "open_failed";
+      return false;
+   }
+   okay = fwrite(&header, sizeof(header), 1, file) == 1
+         && fwrite(pixels, (size_t)header.payload_bytes, 1, file) == 1;
+   if (fclose(file) != 0)
+      okay = false;
+   if (!okay)
+   {
+      unlink(PAUSE_FRAME_NEXT);
+      *failure = "write_failed";
+      return false;
+   }
+   if (rename(PAUSE_FRAME_NEXT, PAUSE_FRAME_RAW) != 0)
+   {
+      unlink(PAUSE_FRAME_NEXT);
+      *failure = "rename_failed";
+      return false;
+   }
+   return true;
+}
+
+bool command_consoleos_pause_frame(command_t *cmd, const char *arg)
+{
+   video_driver_state_t *video_st = video_state_get_ptr();
+   runloop_state_t *runloop_st     = runloop_state_get_ptr();
+   struct pause_frame_capture capture = {
+      NULL, 0, 0, 0, 0, NULL, "no_cpu_frame", 0};
+   uint8_t *published_pixels;
+   uint64_t generation;
+   unsigned scale;
+   unsigned published_width;
+   unsigned published_height;
+   bool cpu_format_supported = false;
+   bool hardware_frame;
+   const char *source_name = "cpu";
+   const char *failure = "no_cpu_frame";
+   retro_time_t received_at = cpu_features_get_time_usec();
+   retro_time_t gpu_readback_us = 0;
+   retro_time_t pixels_at;
+   retro_time_t downsampled_at;
+   retro_time_t published_at;
+
+   unlink(PAUSE_FRAME_NEXT);
+   if (!pause_frame_parse(arg, &generation, &scale))
+   {
+      pause_frame_reply(cmd, false, generation, "invalid_arguments",
+            0, 0, 0, NULL);
+      return false;
+   }
+   if (!(runloop_st->current_core.flags & RETRO_CORE_FLAG_GAME_LOADED))
+   {
+      pause_frame_reply(cmd, false, generation, "no_game", 0, 0, 0, NULL);
+      return false;
+   }
+   if (video_st && video_st->pix_fmt == RETRO_PIXEL_FORMAT_XRGB8888)
+   {
+      cpu_format_supported    = true;
+      capture.bytes_per_pixel = 4U;
+      capture.format          = PAUSE_FRAME_FORMAT_RGBA8888;
+      capture.format_name     = "RGBA8888";
+   }
+   else if (video_st && video_st->pix_fmt == RETRO_PIXEL_FORMAT_RGB565)
+   {
+      cpu_format_supported    = true;
+      capture.bytes_per_pixel = 2U;
+      capture.format          = PAUSE_FRAME_FORMAT_RGB565;
+      capture.format_name     = "RGB565";
+   }
+   hardware_frame = video_driver_cached_frame_is_hw_render();
+   if (cpu_format_supported && !hardware_frame)
+      video_driver_cached_frame_read(&capture, pause_frame_read);
+   if (!capture.pixels && hardware_frame)
+   {
+#if defined(HAVE_SCREENSHOTS)
+      if (!pause_frame_read_gpu(&capture, runloop_get_flags(),
+               &gpu_readback_us))
+         failure = capture.failure &&
+               !string_is_equal(capture.failure, "no_cpu_frame")
+               ? capture.failure : "gpu_readback_failed";
+      else
+         source_name = "gpu";
+#else
+      failure = "gpu_readback_failed";
+#endif
+   }
+   if (!capture.pixels)
+   {
+      if (!hardware_frame)
+         failure = cpu_format_supported ? capture.failure : "unsupported_format";
+      pause_frame_reply(cmd, false, generation, failure,
+            0, 0, 0, NULL);
+      return false;
+   }
+   pixels_at = cpu_features_get_time_usec();
+
+   published_pixels = capture.pixels;
+   published_width  = capture.width;
+   published_height = capture.height;
+   if (scale == 2)
+   {
+      published_width  /= 2U;
+      published_height /= 2U;
+      published_pixels = pause_frame_half(capture.pixels,
+            capture.width, capture.height, capture.bytes_per_pixel);
+      if (!published_pixels)
+      {
+         free(capture.pixels);
+         pause_frame_reply(cmd, false, generation,
+               "allocation_failed", 0, 0, 0, NULL);
+         return false;
+      }
+   }
+   downsampled_at = cpu_features_get_time_usec();
+
+   if (!pause_frame_publish(generation, published_pixels,
+            published_width, published_height, capture.bytes_per_pixel,
+            capture.format, &failure))
+   {
+      if (published_pixels != capture.pixels)
+         free(published_pixels);
+      free(capture.pixels);
+      pause_frame_reply(cmd, false, generation, failure, 0, 0, 0, NULL);
+      return false;
+   }
+   published_at = cpu_features_get_time_usec();
+   pause_frame_reply(cmd, true, generation, NULL,
+         published_width, published_height, capture.bytes_per_pixel,
+         capture.format_name);
+   RARCH_LOG("[ConsoleOS] pause_frame generation=%" PRIu64
+         " source=%s source_dims=%ux%u published=%ux%u format=%s"
+         " pixels_us=%" PRId64 " gpu_readback_us=%" PRId64
+         " conversion_us=%" PRId64 " downsample_us=%" PRId64
+         " publish_us=%" PRId64 " total_us=%" PRId64 "\n",
+         generation, source_name, capture.width, capture.height,
+         published_width, published_height, capture.format_name,
+         pixels_at - received_at, gpu_readback_us, capture.conversion_us,
+         downsampled_at - pixels_at,
+         published_at - downsampled_at, published_at - received_at);
+   if (published_pixels != capture.pixels)
+      free(published_pixels);
+   free(capture.pixels);
+   return true;
+}
+#endif
+
