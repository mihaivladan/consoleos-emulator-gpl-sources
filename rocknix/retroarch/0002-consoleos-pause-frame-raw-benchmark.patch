@@ -576,0 +574,28 @@ static bool take_screenshot_viewport(
+static bool take_screenshot_viewport(
+      const char *screenshot_dir,
+      const char *name_base,
+      bool savestate,
+      uint32_t runloop_flags,
+      bool fullpath,
+      bool use_thread,
+      unsigned pixel_format_type)
+{
+   uint8_t *buffer = NULL;
+   unsigned width = 0;
+   unsigned height = 0;
+   size_t pitch = 0;
+
+   if (!screenshot_read_viewport(&buffer, &width, &height, &pitch,
+            runloop_flags & RUNLOOP_FLAG_IDLE))
+      return false;
+
+   /* Data read from viewport is in bottom-up BGR24 order. */
+   if (screenshot_dump(screenshot_dir, name_base, buffer, width, height,
+            (int)pitch, true, buffer, savestate, runloop_flags,
+            fullpath, use_thread, pixel_format_type))
+      return true;
+
+   free(buffer);
+   return false;
+}
